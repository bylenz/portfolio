---
// ContactForm — interactive form with client-side validation
// Localized strings reach the client script through data-attributes.
import { useTranslations, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="contact-form-card nb-card">
  <div class="form-header">
    <span class="form-label">{t.form.header}</span>
  </div>
  <div class="form-body">
    <form
      id="contact-form"
      novalidate
      data-lang={lang}
      data-i18n={JSON.stringify(t.form.client)}
      data-submit-label={t.form.submit}
    >
      <div class="form-fields">
        <div class="form-field">
          <label class="field-label" for="contact-name"
            >{t.form.nameLabel}</label
          >
          <input
            type="text"
            id="contact-name"
            name="name"
            class="field-input"
            placeholder={t.form.namePlaceholder}
            required
          />
          <span class="field-error" data-error="name" role="alert"></span>
        </div>
        <div class="form-field">
          <label class="field-label" for="contact-email"
            >{t.form.emailLabel}</label
          >
          <input
            type="email"
            id="contact-email"
            name="email"
            class="field-input"
            placeholder={t.form.emailPlaceholder}
            required
          />
          <span class="field-error" data-error="email" role="alert"></span>
        </div>
        <div class="form-field">
          <span class="field-label" id="subject-group-label"
            >{t.form.subjectLabel}</span
          >
          <div
            class="field-options"
            role="radiogroup"
            aria-labelledby="subject-group-label"
          >
            {
              t.form.subjects.map((subject) => (
                <label class="field-option">
                  <input type="radio" name="subject" value={subject} />
                  <span>{subject}</span>
                </label>
              ))
            }
          </div>
          <span class="field-error" data-error="subject" role="alert"></span>
        </div>
        <div class="form-field">
          <label class="field-label" for="contact-message"
            >{t.form.messageLabel}</label
          >
          <textarea
            id="contact-message"
            name="message"
            class="field-input field-textarea"
            placeholder={t.form.messagePlaceholder}
            rows="4"
            required></textarea>
          <span class="field-error" data-error="message" role="alert"></span>
        </div>
        <!-- Honeypot: hidden from people, bots tend to fill it -->
        <div class="hp-field" aria-hidden="true">
          <label for="contact-website">{t.form.honeypotLabel}</label>
          <input
            type="text"
            id="contact-website"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
        </div>
      </div>
      <button
        class="nb-btn nb-btn-dark form-submit"
        type="submit"
        id="contact-submit"
        style="width: 100%; justify-content: center; margin-top: 20px;"
      >
        {t.form.submit} &rarr;
      </button>
    </form>
    <div
      id="form-status"
      class="form-status"
      style="display: none;"
      role="alert"
      aria-live="polite"
    >
    </div>
  </div>
</div>

<style>
  .form-fields {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .field-error {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--coral);
    min-height: 16px;
    display: block;
  }

  .field-input.invalid {
    border-color: var(--coral);
    box-shadow: 3px 3px 0 var(--coral);
  }

  .form-status {
    margin-top: 16px;
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    border: 2px solid;
  }

  .form-status.success {
    background: var(--lime);
    border-color: var(--black);
    color: var(--black);
  }

  .form-status.error {
    background: #fecaca;
    border-color: var(--coral);
    color: var(--coral);
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>

<script>
  type Messages = {
    nameRequired: string;
    emailRequired: string;
    emailInvalid: string;
    subjectRequired: string;
    messageRequired: string;
    sending: string;
    success: string;
    error: string;
    network: string;
  };

  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  interface FormData {
    name: string;
    email: string;
    subject: string;
    message: string;
  }

  interface ValidationError {
    field: string;
    message: string;
  }

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById(
    "contact-submit",
  ) as HTMLButtonElement;

  // Localized strings rendered by the component
  const lang = form?.dataset.lang ?? "es";
  const t = JSON.parse(form?.dataset.i18n ?? "{}") as Messages;
  const submitLabel = form?.dataset.submitLabel ?? "";

  function validate(data: FormData): ValidationError[] {
    const errors: ValidationError[] = [];

    if (!data.name.trim()) {
      errors.push({ field: "name", message: t.nameRequired });
    }

    if (!data.email.trim()) {
      errors.push({ field: "email", message: t.emailRequired });
    } else if (!EMAIL_REGEX.test(data.email)) {
      errors.push({ field: "email", message: t.emailInvalid });
    }

    if (!data.subject) {
      errors.push({ field: "subject", message: t.subjectRequired });
    }

    if (!data.message.trim()) {
      errors.push({ field: "message", message: t.messageRequired });
    }

    return errors;
  }

  function clearErrors(): void {
    document.querySelectorAll(".field-error").forEach((el) => {
      el.textContent = "";
    });
    document.querySelectorAll(".field-input.invalid").forEach((el) => {
      el.classList.remove("invalid");
    });
  }

  function showErrors(errors: ValidationError[]): void {
    errors.forEach(({ field, message }) => {
      const errorEl = document.querySelector(`[data-error="${field}"]`);
      if (errorEl) errorEl.textContent = message;

      // Mark input as invalid
      const input = document.querySelector(
        `[name="${field}"]`,
      ) as HTMLInputElement | null;
      if (input && input.classList) {
        input.classList.add("invalid");
      }
    });
  }

  function showStatus(type: "success" | "error", message: string): void {
    const statusEl = document.getElementById("form-status");
    if (!statusEl) return;
    statusEl.className = `form-status ${type}`;
    statusEl.textContent = message;
    statusEl.style.display = "block";
  }

  form?.addEventListener("submit", async (e: Event) => {
    e.preventDefault();
    clearErrors();

    const formData = new FormData(form);
    const data: FormData = {
      name: (formData.get("name") as string) || "",
      email: (formData.get("email") as string) || "",
      subject: (formData.get("subject") as string) || "",
      message: (formData.get("message") as string) || "",
    };

    const errors = validate(data);
    if (errors.length > 0) {
      showErrors(errors);
      return;
    }

    // Loading state
    submitBtn.disabled = true;
    submitBtn.textContent = t.sending;
    const statusEl = document.getElementById("form-status");
    if (statusEl) statusEl.style.display = "none";

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...data,
          lang,
          // Honeypot: should stay empty for real visitors
          website: (formData.get("website") as string) || "",
        }),
      });

      const result = await response.json();

      if (response.ok && result.success) {
        showStatus("success", t.success);
        form.reset();
      } else {
        // The API already returns messages localized for `lang`
        const msg = result.details?.join(", ") || result.error || t.error;
        showStatus("error", msg);
      }
    } catch {
      showStatus("error", t.network);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = `${submitLabel} →`;
    }
  });
</script>
