---
import { getNavLinks } from "../../data/navigation";
import { homePath, languages, useTranslations, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const navLinks = getNavLinks(lang);
const langs = Object.keys(homePath) as Lang[];
---

<nav id="navbar" aria-label={t.nav.ariaLabel}>
  <div class="nav-inner">
    <a href="#hero" class="nav-logo" aria-label={t.nav.home}>
      <span class="logo-bracket" aria-hidden="true">[</span>
      <span class="logo-text">LENZ_DEV</span>
      <span class="logo-bracket" aria-hidden="true">]</span>
    </a>
    <div class="nav-links" role="list">
      {
        navLinks.map((link) =>
          link.href === "#contact" ? (
            <a
              href={link.href}
              class="nb-btn"
              style="padding: 10px 20px; font-size: 12px;"
              role="listitem"
            >
              {link.label} &rarr;
            </a>
          ) : (
            <a href={link.href} class="nav-link" role="listitem">
              {link.label}
            </a>
          ),
        )
      }
      <div class="lang-switch" role="listitem" aria-label={t.nav.language}>
        {
          langs.map((l) => (
            <a
              href={homePath[l]}
              class:list={["lang-opt", { active: l === lang }]}
              hreflang={l}
              lang={l}
              aria-label={languages[l]}
              aria-current={l === lang ? "page" : undefined}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
    </div>
    <button
      class="hamburger"
      id="hamburger"
      aria-label={t.nav.openMenu}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-label-open={t.nav.openMenu}
      data-label-close={t.nav.closeMenu}
    >
      <span></span><span></span><span></span>
    </button>
  </div>
  <!-- Mobile menu -->
  <div
    class="mobile-menu"
    id="mobile-menu"
    role="navigation"
    aria-label={t.nav.mobileMenu}
  >
    {
      navLinks.map((link) => (
        <a href={link.href} class="mob-link">
          {link.label}
        </a>
      ))
    }
    <div class="lang-switch" role="group" aria-label={t.nav.language}>
      {
        langs.map((l) => (
          <a
            href={homePath[l]}
            class:list={["lang-opt", { active: l === lang }]}
            hreflang={l}
            lang={l}
            aria-label={languages[l]}
            aria-current={l === lang ? "page" : undefined}
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </div>
  </div>
</nav>
