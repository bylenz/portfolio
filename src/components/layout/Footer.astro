---
import { getFooterData, getSocialLinks } from "../../data/navigation";
import { useTranslations, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const footerData = getFooterData(lang);
const socialLinks = getSocialLinks(lang);
const [taglineTop, taglineBottom] = footerData.tagline.split("\n");
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-left">
        <span class="footer-logo" aria-hidden="true">{footerData.logo}</span>
        <p>{taglineTop}<br />{taglineBottom}</p>
      </div>
      <nav class="footer-links" aria-label={t.footer.socialLabel}>
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("http") ? "_blank" : undefined}
              rel={
                link.href.startsWith("http") ? "noopener noreferrer" : undefined
              }
              class="footer-link"
              aria-label={`${link.label}${link.href.startsWith("http") ? ` ${t.newTab}` : ""}`}
            >
              {link.label} ↗
            </a>
          ))
        }
      </nav>
      <div class="footer-right">
        <div class="footer-badge" aria-hidden="true">
          <span>{footerData.copyright}</span>
        </div>
        <p class="footer-built">{footerData.builtWith}</p>
      </div>
    </div>
  </div>
</footer>
