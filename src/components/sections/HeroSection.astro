---
import { getHeroStats, getTechCards } from "../../data/navigation";
import { useTranslations, type Lang } from "../../i18n/ui";
import TechIcon from "../ui/TechIcon";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const heroStats = getHeroStats(lang);
const techCards = getTechCards(lang);
---

<section id="hero" class="hero">
  <!-- Grid background -->
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-inner">
      <!-- Left: Main content -->
      <div class="hero-content">
        <!-- Status badge -->
        <div class="status-badge observe" role="status">
          <span class="status-dot" aria-hidden="true"></span>
          <span>{t.hero.status}</span>
        </div>

        <!-- Main headline -->
        <div class="headline-wrap observe" style="animation-delay: 0.1s">
          <h1 class="hero-title">
            <span class="title-line">Lenz</span>
            <span class="title-line accent-yellow">AI ENG.</span>
            <span class="title-line title-line--sm">& Architect</span>
          </h1>
        </div>

        <!-- Description -->
        <p
          class="hero-desc observe"
          style="animation-delay: 0.2s"
          set:html={t.hero.desc}
        />

        <!-- CTA buttons -->
        <div class="hero-cta observe" style="animation-delay: 0.3s">
          <a href="#projects" class="nb-btn">{t.hero.ctaProjects} &rarr;</a>
          <a href="#contact" class="nb-btn nb-btn-outline"
            >{t.hero.ctaContact}</a
          >
        </div>

        <!-- Stats row -->
        <div
          class="hero-stats observe"
          style="animation-delay: 0.4s"
          role="list"
          aria-label={t.hero.statsLabel}
        >
          {
            heroStats.map((stat, i) => (
              <>
                {i > 0 && <div class="stat-divider" aria-hidden="true" />}
                <div class="stat" role="listitem">
                  <span class="stat-num">{stat.value}</span>
                  <span class="stat-label">{stat.label}</span>
                </div>
              </>
            ))
          }
        </div>
      </div>

      <!-- Right: Visual card -->
      <div
        class="hero-visual observe"
        style="animation-delay: 0.2s"
        aria-hidden="true"
      >
        <div class="visual-card nb-card">
          <!-- Terminal-style header -->
          <div class="term-header">
            <div class="term-dots">
              <span style="background:#ff5f57"></span>
              <span style="background:#ffbd2e"></span>
              <span style="background:#28c840"></span>
            </div>
            <span class="term-title">profile.json</span>
          </div>
          <div class="term-body">
            <pre
              class="code-block"><code><span class="c-bracket">{"{"}</span>
  <span class="c-key">"role"</span><span class="c-colon">:</span> <span class="c-str">"AI Engineer"</span><span class="c-comma">,</span>
  <span class="c-key">"superpower"</span><span class="c-colon">:</span> <span class="c-str">"AI-powered dev flow"</span><span class="c-comma">,</span>
  <span class="c-key">"frontend"</span><span class="c-colon">:</span> <span class="c-arr">[</span>
    <span class="c-str">"React"</span><span class="c-comma">,</span> <span class="c-str">"Next.js"</span>
  <span class="c-arr">]</span><span class="c-comma">,</span>
  <span class="c-key">"backend"</span><span class="c-colon">:</span> <span class="c-arr">[</span>
    <span class="c-str">"NestJS"</span><span class="c-comma">,</span> <span class="c-str">"FastAPI"</span>
  <span class="c-arr">]</span><span class="c-comma">,</span>
  <span class="c-key">"ai_libs"</span><span class="c-colon">:</span> <span class="c-arr">[</span>
    <span class="c-str">"LangChain"</span><span class="c-comma">,</span>
    <span class="c-str">"LangGraph"</span><span class="c-comma">,</span>
    <span class="c-str">"LlamaIndex"</span><span class="c-comma">,</span>
    <span class="c-str">"PydanticAI"</span>
  <span class="c-arr">]</span><span class="c-comma">,</span>
  <span class="c-key">"status"</span><span class="c-colon">:</span> <span class="c-bool">true</span>
<span class="c-bracket">{"}"}</span></code></pre>
          </div>
        </div>

        <!-- Floating tags -->
        <div class="float-tag float-tag--1">
          <span>🤖 AI-First</span>
        </div>
        <div class="float-tag float-tag--2">
          <span>⚡ Full-Stack</span>
        </div>
        <div class="float-tag float-tag--3">
          <span>🏗️ {t.hero.floatArchitect}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Tech cards grid -->
  <div class="tech-cards-section observe" style="animation-delay: 0.5s">
    <div class="container">
      <div
        class="tech-cards-grid"
        role="list"
        aria-label={t.hero.techStackLabel}
      >
        {
          techCards.map((card) => (
            <div
              class="tech-card nb-card"
              role="listitem"
              style={`--card-accent: ${card.color}`}
            >
              <span class="tech-card-icon" aria-hidden="true">
                <TechIcon name={card.icon} size={22} />
              </span>
              <span class="tech-card-label">{card.label}</span>
              <span class="tech-card-category">{card.category}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
