---
import { getSoftSkills } from "../../data/navigation";
import { useTranslations, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const softSkills = getSoftSkills(lang);
---

<section id="about" class="section">
  <div class="container">
    <!-- Section header -->
    <div class="section-header observe">
      <span class="section-tag">{t.about.tag}</span>
      <h2 class="section-title" set:html={t.about.title} />
    </div>

    <div class="about-grid">
      <!-- Main text card -->
      <div class="about-main nb-card observe" style="animation-delay:0.1s">
        <div class="about-main-inner">
          <div class="about-label">{t.about.approach}</div>
          <p class="about-text" set:html={t.about.p1} />
          <p class="about-text" set:html={t.about.p2} />
          <div class="about-pills">
            {t.about.pills.map((pill) => <span class="pill">{pill}</span>)}
          </div>
        </div>
      </div>

      <!-- Right column -->
      <div class="about-right">
        <!-- Philosophy card -->
        <div
          class="philosophy-card nb-card observe"
          style="animation-delay:0.2s"
        >
          <div class="philosophy-icon" aria-hidden="true">⚙️</div>
          <h3>{t.about.philosophyTitle}</h3>
          <p set:html={t.about.philosophy} />
        </div>

        <!-- Soft skills grid -->
        <div
          class="softskills-card nb-card observe"
          style="animation-delay:0.3s"
        >
          <div class="softskills-label">{t.about.softSkills}</div>
          <div class="softskills-grid">
            {
              softSkills.map((skill) => (
                <div class="softskill-item">
                  <span class="softskill-icon" aria-hidden="true">
                    {skill.icon}
                  </span>
                  <span class="softskill-label">{skill.label}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Philosophy banner -->
    <div class="ai-banner observe" style="animation-delay:0.4s">
      <div class="ai-banner-inner">
        <div class="ai-banner-left">
          <span class="ai-banner-icon" aria-hidden="true">🤖</span>
          <div>
            <strong>{t.about.bannerTitle}</strong>
            <p>{t.about.bannerText}</p>
          </div>
        </div>
        <div class="ai-banner-badge">
          <span>10x</span>
          <small>{t.about.bannerBadge}</small>
        </div>
      </div>
    </div>
  </div>
</section>
