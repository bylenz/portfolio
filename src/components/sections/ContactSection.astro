---
import { getSocialLinks } from "../../data/navigation";
import { useTranslations, type Lang } from "../../i18n/ui";
import ContactForm from "../interactive/ContactForm.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const socialLinks = getSocialLinks(lang);
---

<section id="contact" class="section contact-section">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-left observe">
        <span class="section-tag">{t.contact.tag}</span>
        <h2 class="contact-title" set:html={t.contact.title} />
        <p class="contact-desc">{t.contact.desc}</p>
        <div
          class="contact-links"
          role="list"
          aria-label={t.contact.linksLabel}
        >
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                class="contact-link nb-card"
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  link.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
                role="listitem"
                aria-label={`${link.label}: ${link.value}${link.href.startsWith("http") ? ` ${t.newTab}` : ""}`}
              >
                <span class="contact-link-icon" aria-hidden="true">
                  {link.icon}
                </span>
                <div>
                  <span class="contact-link-label">{link.label}</span>
                  <span class="contact-link-value">{link.value}</span>
                </div>
                <span class="contact-link-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))
          }
        </div>
      </div>

      {/* Contact form */}
      <div class="contact-right observe" style="animation-delay: 0.2s">
        <ContactForm lang={lang} />
      </div>
    </div>
  </div>
</section>
